{
  "name": "@dta-au/design-system",
  "version": "1.0.0",
  "license": "GPL-2.0-or-later",
  "description": "CivicTheme UI Kit with Storybook integration",
  "keywords": [
    "ui kit",
    "uikit",
    "components",
    "component library",
    "design system",
    "pattern library",
    "storybook",
    "styleguide"
  ],
  "homepage": "https://github.com/dta-au/design-system",
  "bugs": "https://github.com/dta-au/design-system/issues",
  "repository": "https://github.com/dta-au/design-system.git",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "cpu": [
    "x64",
    "arm",
    "arm64",
    "ia32"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dist": "npm run dist --workspaces",
    "storybook:twig": "npm run storybook --workspace=packages/twig",
    "storybook:sdc": "npm run storybook --workspace=packages/sdc",
    "build-storybook": "npm run build-storybook --workspaces",
    "dev:twig": "npm run dev --workspace=packages/twig",
    "dev:sdc": "npm run dev --workspace=packages/sdc",
    "test": "npm run test --workspaces",
    "test:all": "npm run test && node tools/scripts/tests/test.js && node tools/scripts/tests/sbom-generate.test.js",
    "test:ci": "npm run test:ci --workspaces",
    "lint": "npm run lint --workspaces && eslint 'tools/scripts/**/*.js' 'tools/vite/**/*.js' && npm run validate",
    "lint:fix": "npm run lint:fix --workspaces && eslint 'tools/scripts/**/*.js' 'tools/vite/**/*.js' --fix",
    "validate": "node tools/scripts/validate-theme-variables.js && node tools/scripts/validate-component-enums.js && node tools/scripts/validate-stories-backgrounds.js && node tools/scripts/validate-theme-variable-usage.js && node tools/scripts/validate-content-md.js",
    "check:bundles": "node tools/scripts/validate-runtime-bundles.js && node tools/scripts/validate-package-entries.js",
    "sbom": "node tools/scripts/sbom-generate.js",
    "sbom:dist": "node tools/scripts/sbom-generate.js --target dist",
    "diff:snapshot": "./tools/scripts/snapshot-diff.sh",
    "components:update": "npm run components:update:sdc && npm run components:update:twig",
    "components:update:sdc": "node tools/scripts/components-update-sdc.js packages/sdc",
    "components:update:twig": "node tools/scripts/components-update-twig.js packages/sdc/components packages/twig/components",
    "components:update:twig:headers": "node tools/scripts/components-update-twig.js packages/sdc/components packages/twig/components --headers-only",
    "components:check": "npm run components:check:sdc && npm run components:check:twig",
    "components:check:sdc": "node tools/scripts/components-update-sdc.js packages/sdc --check",
    "components:check:twig": "node tools/scripts/components-update-twig.js packages/sdc/components packages/twig/components --check",
    "components:check:twig:headers": "node tools/scripts/components-update-twig.js packages/sdc/components packages/twig/components --headers-only --check",
    "prepare": "node .husky/install.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@stylistic/stylelint-plugin": "^5.0.1",
    "eslint": "^10.0.3",
    "eslint-plugin-import-newlines": "^2.0.0",
    "glob": "^13.0.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.3.0",
    "jest-transform-stub": "^2.0.0",
    "js-yaml": "^4.1.0",
    "prettier": "^3.5.0",
    "regenerator-runtime": "^0.14.1",
    "stylelint": "^17.4.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "twig-testing-library": "^1.2.0",
    "vite": "^6.3.5"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.40.2"
  },
  "overrides": {
    "@whitespace/storybook-addon-html": {
      "storybook": "10.4.2"
    },
    "brace-expansion": "^5.0.8",
    "locutus": "^3.0.25",
    "twig": "^3.0.0",
    "drupal-attribute": "git+https://gitlab.com/richardgaunt/drupal-attribute.git#8ba9e77760b35a68c34bf5795fecab1963759f4d",
    "drupal-twig-extensions": "git+https://github.com/richardgaunt/drupal-twig-extensions.git#092058b870917ffd6e15ce07503e32a471484147"
  }
}
