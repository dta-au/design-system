{#
/**
 * @file
 * CivicTheme Webform component.
 *
 * Props:
 * - theme: [string] Theme variation (light or dark).
 * - is_contained: [boolean] Whether to wrap the content in a container.
 * - vertical_spacing: [string] Webform vertical spacing (top, bottom, or both).
 * - with_background: [boolean] Whether to display with a background.
 * - modifier_class: [string] Additional CSS classes.
 * - attributes: [Drupal\Core\Template\Attribute] Additional HTML attributes.
 *
 * Slots:
 * - referenced_webform: Rendered webform HTML.
 */
#}

{% set is_contained = is_contained is not same as(false) %}
{% set vertical_spacing_class = vertical_spacing in ['top', 'bottom', 'both'] ? 'ct-vertical-spacing-inset--%s'|format(vertical_spacing) : '' %}
{% set with_background_class = with_background ? 'ct-webform--with-background' : '' %}
{% set not_contained_class = not is_contained ? 'ct-webform--not-contained' : '' %}
{% set theme_class = 'ct-theme-%s'|format(theme|default('light')) %}
{% set modifier_class = '%s %s %s %s %s'|format(theme_class, vertical_spacing_class, with_background_class, not_contained_class, modifier_class|default('')) %}

{% if referenced_webform is not empty %}
  <div class="ct-webform {{ modifier_class -}}" {% if attributes is defined and attributes is not null %}{{- attributes -}}{% endif %}>
    {% if is_contained %}
    <div class="container">
      <div class="row">
        <div class="col-xxs-12">
          {% endif %}
          {{ referenced_webform }}
          {% if is_contained %}
        </div>
      </div>
    </div>
    {% endif %}
  </div>
{% endif %}
