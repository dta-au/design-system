    "autodetect": [
        {
            "records": [
                {
                    "year": "2020",
                    "value": "10",
                    "count": "5"
                }
            ],
            "expect": {
                "x_key": "year",
                "y_keys": [
                    "value",
                    "count"
                ]
            }
        },
        {
            "records": [
                {
                    "region": "NSW",
                    "pop": "100"
                }
            ],
            "expect": {
                "x_key": "region",
                "y_keys": [
                    "pop"
                ]
            }
        },
        {
            "records": [
                {
                    "label": "A",
                    "clean": "7",
                    "padded": " 10 "
                }
            ],
            "expect": {
                "x_key": "label",
                "y_keys": [
                    "clean",
                    "padded"
                ]
            }
        },
        {
            "records": [
                {
                    "label": "A",
                    "num": "5",
                    "comma": "1,000"
                }
            ],
            "expect": {
                "x_key": "label",
                "y_keys": [
                    "num"
                ]
            }
        },
        {
            "records": [
                {
                    "year": "2020",
                    "month": "3"
                }
            ],
            "expect": {
                "x_key": "year",
                "y_keys": [
                    "month"
                ]
            }
        },
        {
            "records": [
                {
                    "a": "1",
                    "b": "2"
                }
            ],
            "expect": {
                "x_key": "a",
                "y_keys": [
                    "b"
                ]
            }
        },
        {
            "records": [
                {
                    "name": "x",
                    "amount": 42
                }
            ],
            "expect": {
                "x_key": "name",
                "y_keys": [
                    "amount"
                ]
            }
        },
        {
            "records": [
                {
                    "cat": "a",
                    "v": "1"
                },
                {
                    "cat": "b",
                    "v": "2"
                }
            ],
            "expect": {
                "x_key": "cat",
                "y_keys": [
                    "v"
                ]
            }
        }
    ],
    "key_absent": [
        {
            "csv": "label,val\nA,1",
            "x_hint": "label",
            "y_hint": [],
            "expect_error": false
        },
        {
            "csv": "label,val\nA,1",
            "x_hint": "missing",
            "y_hint": [],
            "expect_error": true
        },
        {
            "csv": "label,val\nA,1",
            "x_hint": "",
            "y_hint": [
                "nope"
            ],
            "expect_error": true
        },
        {
            "csv": "label,val\nA,1",
            "x_hint": "",
            "y_hint": [
                "val"
            ],
            "expect_error": false
        },
        {
            "csv": "region,count\nNSW,12\nVIC,oops",
            "x_hint": "region",
            "y_hint": [
                "count"
            ],
            "expect_error": false
        }
    ]
}
