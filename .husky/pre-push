#!/bin/sh

# Run dist
echo "Running dist..."
npm run dist
if [ $? -ne 0 ]; then
  echo "❌ Dist failed. Push aborted."
  exit 1
fi

# Run components:update
echo "Running components:update..."
npm run components:update
if [ $? -ne 0 ]; then
  echo "❌ Components update failed. Push aborted."
  exit 1
fi

# Check for uncommitted changes after components:update. dist/ is excluded –
# CI rebuilds it before check:bundles and release.yml rebuilds it from the tag,
# so its churn is not worth a commit on every push.
if ! git diff --quiet -- . ':(exclude)packages/*/dist/*' || \
   ! git diff --cached --quiet -- . ':(exclude)packages/*/dist/*'; then
  echo "❌ There are uncommitted changes after running 'npm run components:update'."
  echo "Please commit the changes before pushing."
  git status --short -- . ':(exclude)packages/*/dist/*'
  exit 1
fi

# Run lint
echo "Running lint..."
npm run lint
if [ $? -ne 0 ]; then
  echo "❌ Lint failed. Push aborted."
  exit 1
fi

# Run tests
echo "Running tests..."
npm run test
if [ $? -ne 0 ]; then
  echo "❌ Tests failed. Push aborted."
  exit 1
fi

echo "✅ All pre-push checks passed!"