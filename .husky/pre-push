#!/bin/sh

# Tag pushes gate on semver intent first, before the expensive build below.
# Git feeds pre-push one "<local ref> <local sha> <remote ref> <remote sha>"
# line per ref; a terminal on stdin means it was run by hand, with no refs.
if [ ! -t 0 ]; then
  REFS=$(cat)
  for TAG in $(printf '%s\n' "$REFS" | awk '$1 ~ /^refs\/tags\/v/ { sub(/^refs\/tags\//, "", $1); print $1 }'); do
    node tools/scripts/check-release-tag.js "$TAG" || exit 1
  done
fi

# Run dist
echo "Running dist..."
npm run dist
if [ $? -ne 0 ]; then
  echo "❌ Dist failed. Push aborted."
  exit 1
fi

# Run components:update
echo "Running components:update..."
npm run components:update
if [ $? -ne 0 ]; then
  echo "❌ Components update failed. Push aborted."
  exit 1
fi

# Only components:update output has to be committed. dist/ is rebuilt in CI and
# at release, and unrelated working changes are not this hook's business.
# status, not diff: it also sees newly generated files.
CHANGED=$(git status --porcelain -- packages/sdc/components packages/twig/components)
if [ -n "$CHANGED" ]; then
  echo "❌ There are uncommitted changes after running 'npm run components:update'."
  echo "Please commit the changes before pushing."
  echo "$CHANGED"
  exit 1
fi

# Run lint
echo "Running lint..."
npm run lint
if [ $? -ne 0 ]; then
  echo "❌ Lint failed. Push aborted."
  exit 1
fi

# Run tests
echo "Running tests..."
npm run test
if [ $? -ne 0 ]; then
  echo "❌ Tests failed. Push aborted."
  exit 1
fi

echo "✅ All pre-push checks passed!"